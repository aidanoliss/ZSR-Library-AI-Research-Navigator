# Copy this file to .env and fill in only the providers you use.

# Optional LLM providers. The MVP uses deterministic sample analysis until a
# reviewed server-side adapter is enabled behind lib/llm.js.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VENTURE_RADAR_LLM_PROVIDER=openai
VENTURE_RADAR_LLM_MODEL=

# Wake Forest's LibKey / Third Iron library ID (frontend/Vite var).
# When ZSR provides Wake Forest's LibKey library ID, set this to enable direct
# Wake-specific LibKey full-text links (https://libkey.io/libraries/{id}/{doi}).
# Without it, the app uses LibKey's choose-library fallback, where the student
# selects Wake Forest University once. No LibKey API key is used in this prototype.
VITE_WFU_LIBKEY_LIBRARY_ID=

# Supabase. Never expose SUPABASE_SERVICE_ROLE_KEY in browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local weekly report worker defaults.
VENTURE_RADAR_PERIOD_START=2026-06-10
VENTURE_RADAR_PERIOD_END=2026-06-17
VENTURE_RADAR_MANUAL_URLS=

# Server
PORT=3001

# Legacy ZSR assistant endpoints are still present but not used by Venture Radar.
GEMINI_MODEL=gemini-2.5-flash
LOG_QUERIES=on
RATE_MAX=30
RATE_WINDOW_MS=600000
PRIMO_LIVE=on
