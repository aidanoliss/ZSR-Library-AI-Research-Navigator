# Copy this file to .env for local development.
# For Render, set these values in the service Environment tab instead.

# Required for live AI responses. Keep this server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Wake Forest's LibKey / Third Iron library ID (frontend/Vite var).
# When ZSR provides Wake Forest's LibKey library ID, set this to enable direct
# Wake-specific LibKey full-text links (https://libkey.io/libraries/{id}/{doi}).
# Without it, the app uses LibKey's choose-library fallback, where the student
# selects Wake Forest University once. No LibKey API key is used in this prototype.
VITE_WFU_LIBKEY_LIBRARY_ID=

# Server
PORT=3001
HOST=0.0.0.0

# Keep query logging off until ZSR approves retention and student notice language.
LOG_QUERIES=off
# Handoff submissions never retain contact details unless this is explicitly enabled.
HANDOFF_STORE_CONTACT=off
ASK_ZSR_EMAIL=askzsr@wfu.edu

# Single-instance request and simultaneous-work limiting. Use a shared rate
# limiter and an authenticated gateway before any multi-instance public launch.
RATE_MAX=30
RATE_WINDOW_MS=600000
MAX_ACTIVE_CHAT_GLOBAL=8
MAX_ACTIVE_CHAT_PER_CLIENT=2

# Public ZSR discovery lookup. This is best-effort metadata, not an approved API.
PRIMO_LIVE=on

# Official Primo API adapter. Keep the profile off in shared deployments until
# a server-side key and matching profile have been reviewed.
#
# Guest contract spike:
#   PRIMO_API_PROFILE=guest
#   PRIMO_API_KEY=<your Ex Libris guest-sandbox key>
#   PRIMO_API_USE_FOR_DISCOVERY=off
#
# Institutional staging requires ZSR-approved endpoint/view/tab/scope values.
PRIMO_API_PROFILE=off
PRIMO_API_ENDPOINT=
PRIMO_API_KEY=
PRIMO_API_RECORD_HOST=
PRIMO_API_VID=
PRIMO_API_INST=
PRIMO_API_CATALOG_TAB=
PRIMO_API_CATALOG_SCOPE=
PRIMO_API_ARTICLES_TAB=
PRIMO_API_ARTICLES_SCOPE=
PRIMO_API_USE_FOR_DISCOVERY=off
PRIMO_API_TIMEOUT_MS=8000

# Optional OpenAlex open-access source lane. The API key stays server-side and
# is never returned to the browser. The provider retrieves metadata only.
OPENALEX_LIVE=on
OPENALEX_API_KEY=

# Optional AI passage selection has one total deadline across all retries.
GEMINI_TOTAL_TIMEOUT_MS=25000
# Set only to a dedicated directory on a verified persistent mount.
# A path on a free/ephemeral host is NOT durable. Single writer only.
# Example after provisioning a disk: PILOT_DATA_DIR=/var/data/zsr-pilot
PILOT_DATA_DIR=
