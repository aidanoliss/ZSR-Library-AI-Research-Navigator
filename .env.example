# Copy this file to .env for local development.
# For Render, set these values in the service Environment tab instead.

# Required for live AI responses. Keep this server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Wake Forest's LibKey / Third Iron library ID (frontend/Vite var).
# When ZSR provides Wake Forest's LibKey library ID, set this to enable direct
# Wake-specific LibKey full-text links (https://libkey.io/libraries/{id}/{doi}).
# Without it, the app uses LibKey's choose-library fallback, where the student
# selects Wake Forest University once. No LibKey API key is used in this prototype.
VITE_WFU_LIBKEY_LIBRARY_ID=

# Server
PORT=3001
HOST=0.0.0.0

# Keep query logging off until ZSR approves retention and student notice language.
LOG_QUERIES=off
# Handoff submissions never retain contact details unless this is explicitly enabled.
HANDOFF_STORE_CONTACT=off
ASK_ZSR_EMAIL=askzsr@wfu.edu

# Basic in-memory request limiting.
RATE_MAX=30
RATE_WINDOW_MS=600000

# ZSR catalog/Primo lookup settings. Leave credentials blank unless ZSR provides
# an approved Primo API endpoint and key.
PRIMO_LIVE=on
PRIMO_API_ENDPOINT=
PRIMO_API_KEY=

# Optional OpenAlex open-access source lane. The API key stays server-side and
# is never returned to the browser. The provider retrieves metadata only.
OPENALEX_LIVE=on
OPENALEX_API_KEY=
